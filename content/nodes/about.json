[
  {
    "id": "about",
    "label": "About this business",
    "parent": null,
    "intents": ["about this business", "your company", "your business", "what is this", "what is mindunder"],
    "tags": ["overview", "identity"],
    "blocks": [
      { "type": "text", "content": "mindunder.dev is a business run by one person. I design and build software that does routine business work automatically." },
      { "type": "split", "left": [
        { "type": "metricRow", "items": [{ "value": "3", "label": "Active projects" }, { "value": "1", "label": "Person" }] }
      ], "right": [
        { "type": "pills", "label": "Areas of work", "items": ["Designing how work moves", "Automated systems", "Process design"] }
      ]},
      { "type": "text", "content": "The aim is simple. A decision you make in the morning is carried out the same day, and nobody has to chase it." }
    ],
    "chips": [
      { "target": "projects" },
      { "target": "philosophy" },
      { "target": "ruben" }
    ]
  },
  {
    "id": "philosophy",
    "label": "How I choose software tools",
    "parent": null,
    "intents": ["philosophy", "approach", "which software", "which tools", "tools", "platform", "platforms"],
    "tags": ["identity"],
    "blocks": [
      { "type": "text", "content": "Most business software does four things. It collects information, helps someone decide, carries out an action, and keeps a record." },
      { "type": "flow", "layout": "horizontal", "nodes": [
        { "id": "o", "label": "Collect information" },
        { "id": "d", "label": "Decide" },
        { "id": "a", "label": "Act" },
        { "id": "r", "label": "Keep a record" }
      ], "edges": [
        { "from": "o", "to": "d" },
        { "from": "d", "to": "a" },
        { "from": "a", "to": "r" }
      ], "loop": { "from": "r", "to": "o", "label": "repeat" } },
      { "type": "text", "content": "I design those four steps first. After that, I choose the software. This means you are not tied to one supplier." }
    ],
    "chips": [
      { "target": "projects" },
      { "target": "haios" },
      { "target": "salesforce" }
    ]
  },
  {
    "id": "salesforce",
    "label": "My Salesforce work",
    "parent": null,
    "intents": ["salesforce", "crm", "london & partners", "certification", "certifications", "certified"],
    "tags": ["identity", "background"],
    "blocks": [
      { "type": "text", "content": "My main job is looking after Salesforce at London & Partners. Salesforce is software that companies use to keep track of their customers." },
      { "type": "text", "content": "That work taught me one thing above all. When automation fails, the cause is usually how people work together, not the software." },
      { "type": "split", "left": [
        { "type": "pills", "label": "Salesforce certifications", "items": ["Salesforce Administrator", "Salesforce Platform App Builder", "Salesforce Agentforce Specialist"] }
      ], "right": [
        { "type": "stats", "items": [{ "label": "Employer", "value": "London & Partners" }, { "label": "Help articles written", "value": "More than 37" }] }
      ]},
      { "type": "text", "content": "I use the same way of thinking to plan a Salesforce task and an AI system. Only the software is different." }
    ],
    "chips": [
      { "target": "haios" },
      { "target": "callsheet" },
      { "target": "projects" }
    ]
  },
  {
    "id": "ruben",
    "label": "About me",
    "parent": null,
    "intents": ["who", "ruben", "about you", "founder", "background", "your experience"],
    "tags": ["identity", "overview"],
    "blocks": [
      { "type": "text", "content": "My name is Ruben. I live and work in London." },
      { "type": "text", "content": "I have spent several years automating work for other organisations. I now build systems that need as little manual work as possible. I work alone, by choice." },
      { "type": "pills", "label": "Salesforce certifications", "items": ["Salesforce Administrator", "Salesforce Platform App Builder", "Salesforce Agentforce Specialist"] },
      { "type": "badge", "status": "Based in London, UK", "variant": "default" },
      { "type": "callout", "text": "In my experience, much of the complexity in a business process is not needed. When the design is simpler, the work is simpler." },
      { "type": "fact", "key": "handover" }
    ],
    "chips": [
      { "target": "projects" },
      { "target": "salesforce" },
      { "target": "about" }
    ]
  }
]
