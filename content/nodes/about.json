      { "type": "text", "content": "mindunder.dev is one person: me. I design and build software that does routine business work." },
      {
        "type": "split",
        "left": [{ "type": "metricRow", "items": [{ "value": "3", "label": "Active projects" }, { "value": "1", "label": "Person" }] }],
        "right": [{ "type": "pills", "label": "Areas of work", "items": ["Designing how work moves", "Automated systems", "Process design"] }]
      },
      { "type": "text", "content": "The aim is simple. A decision made in the morning is carried out the same day, without anyone chasing it." }
    ],
    "chips": [{ "target": "projects" }, { "target": "philosophy" }, { "target": "ruben" }]
  },
  {
    "id": "philosophy",
    "label": "How I choose software",
    "parent": null,
    "intents": ["philosophy", "approach", "which software", "which tools", "tools", "platform", "platforms"],
    "tags": ["identity"],
    "blocks": [
      { "type": "text", "content": "Most business software does four things. It collects, decides, acts and keeps a record." },
      {
        "type": "flow",
        "layout": "horizontal",
        "nodes": [
          { "id": "o", "label": "Collect information" },
          { "id": "d", "label": "Decide" },
          { "id": "a", "label": "Act" },
          { "id": "r", "label": "Keep a record" }
        ],
        "edges": [{ "from": "o", "to": "d" }, { "from": "d", "to": "a" }, { "from": "a", "to": "r" }],
        "loop": { "from": "r", "to": "o", "label": "repeat" }
      },
      { "type": "text", "content": "I design those four steps first, then choose the software. You are not tied to one supplier." }
    ],
    "chips": [{ "target": "projects" }, { "target": "haios" }, { "target": "salesforce" }]
  },
  {
