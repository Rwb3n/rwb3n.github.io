          { "value": "95%", "label": "problems fixed without me (approximate)" },
          { "value": "£36", "label": "a month to run" }
        ]
      },
      { "type": "fact", "key": "callsheetUrl" }
    ],
    "chips": [{ "target": "process" }, { "target": "projects" }, { "target": "ruben" }]
  },
  {
    "id": "process",
    "label": "How we start",
    "parent": null,
    "intents": ["process", "how do we start", "getting started", "get started", "work together", "engagement", "hire", "steps", "next step"],
    "tags": ["overview"],
    "blocks": [
      { "type": "text", "content": "Five steps. Always in this order." },
      {
        "type": "layers",
        "items": [
          { "label": "1", "title": "We talk. I listen.", "detail": "What works, what is hard, what you want automated." },
          { "label": "2", "title": "I map the real work", "detail": "What people actually do. Where the time goes." },
          { "label": "3", "title": "I show you a design", "detail": "What stays, what changes, what becomes automatic. Nothing changes until you approve it." },
          {
            "label": "4",
            "title": "I build it. We test it.",
            "detail": "A person checks everything at first. It runs alone only after it has shown that it works."
          },
          { "label": "5", "title": "It runs. You decide.", "detail": "The system does the routine work. You make the calls that need judgement." }
        ]
      },
      { "type": "fact", "key": "firstStep" },
      { "type": "fact", "key": "cost" },
      { "type": "fact", "key": "timeline" },
      { "type": "fact", "key": "handover" }
    ],
    "chips": [{ "target": "contact" }, { "target": "cost" }, { "target": "trust_ladder" }]
  },
