[
  {
    "id": "method",
    "label": "What I do",
    "parent": null,
    "intents": ["what do you do", "what you do", "method", "how it works", "services", "service"],
    "tags": ["overview"],
    "blocks": [
      { "type": "text", "content": "I map how work moves through your business. Then I automate the steps people repeat." },
      {
        "type": "compare",
        "label": "View",
        "states": [
          {
            "key": "before",
            "label": "Before",
            "title": "Before. People pass the work along.",
            "stat": { "value": "2", "label": "routine steps done by hand" },
            "text": "Every hand-off is a wait. Every wait is a chance of a mistake.",
            "nodes": [
              { "id": "info", "label": "Information" },
              { "id": "p1", "label": "Person", "variant": "muted" },
              { "id": "dec", "label": "Decision" },
              { "id": "p2", "label": "Person", "variant": "muted" },
              { "id": "act", "label": "Action" }
            ]
          },
          {
            "key": "after",
            "label": "After",
            "title": "After. The system does the routine steps.",
            "stat": { "value": "0", "label": "routine steps done by hand" },
            "text": "The system collects and checks. You decide. The system acts.",
            "nodes": [
              { "id": "info", "label": "Information" },
              { "id": "sys", "label": "System", "variant": "accent", "via": "collects" },
              { "id": "dec", "label": "Your decision", "via": "prepares" },
              { "id": "act", "label": "System acts", "via": "you approve" }
            ]
          }
        ]
      }
    ],
    "chips": [{ "target": "estimate" }, { "target": "trust_ladder" }, { "target": "proof" }, { "target": "process" }]
  },
  {
    "id": "ahead",
    "label": "What you get",
    "parent": null,
    "intents": ["benefit", "benefits", "what do i get", "outcome", "outcomes", "value"],
    "tags": ["overview"],
    "blocks": [
      { "type": "text", "content": "You hear about changes early, while there is time to act." },
      {
        "type": "text",
        "content": "My own system reads UK company records, insolvency notices and contract awards every night. It reports changes the same morning."
      },
      { "type": "text", "content": "Yours would read the sources that matter in your market." }
    ],
    "chips": [{ "target": "signals" }, { "target": "method" }]
  },
  {
    "id": "estimate",
    "label": "What repeated work costs",
    "parent": null,
    "intents": [
      "estimate",
      "calculate",
      "calculator",
      "how much time",
      "time wasted",
      "waste time",
      "save time",
      "savings",
      "roi",
      "return on investment",
      "worth it"
    ],
    "tags": ["overview", "tool"],
    "blocks": [
      { "type": "text", "content": "One task your team repeats. Three numbers." },
      {
        "type": "estimate",
        "title": "Estimate",
        "inputs": [
          { "key": "people", "label": "People doing it", "min": 1, "max": 500, "step": 1, "value": 3, "less": "One person fewer", "more": "One person more" },
          {
            "key": "hours",
            "label": "Hours each, per week",
            "min": 0.5,
            "max": 40,
            "step": 0.5,
            "value": 4,
            "less": "Half an hour less",
            "more": "Half an hour more"
          },
          {
            "key": "rate",
            "label": "Cost per hour",
            "hint": "Salary plus other staff costs. From 5 to 500.",
            "min": 5,
            "max": 500,
            "step": 1,
            "value": 30,
            "prefix": "£",
            "less": "One pound less",
            "more": "One pound more"
          }
        ],
        "labels": {
          "hours": "Hours a year",
          "cost": "Cost a year",
          "weeksBefore": "Equal to",
          "weeksAfter": "full working weeks.",
          "key": "One square is one working week of 37.5 hours. Two rows are one full-time person for a year.",
          "more": "+ {n} more weeks"
        },
        "weeksPerYear": 46,
        "hoursPerWeek": 37.5,
        "note": "Uses only what you type. Nothing is sent. Assumes 46 working weeks a year. An estimate, not a quote.",
        "addLabel": "Add to my summary",
        "added": "Added to your summary."
      },
      { "type": "text", "content": "A system rarely removes a task completely. It does the routine part. A person checks the result." }
    ],
    "chips": [{ "target": "method" }, { "target": "process" }, { "label": "Your summary", "target": "_show_brief" }]
  },
  {
    "id": "signals",
    "label": "Problems I solve",
    "parent": null,
    "intents": ["problems", "problem you solve", "examples", "symptoms", "pain points"],
    "tags": ["overview"],
    "blocks": [
      { "type": "text", "content": "Four common problems. These are examples, not client stories." },
      {
        "type": "grid",
        "items": [
          { "title": "A supplier fails without warning", "description": "You hear it from a customer.", "target": "signal_blindside" },
          { "title": "Reports built by hand", "description": "The same spreadsheet, every week.", "target": "signal_monday" },
          { "title": "Tenders found too late", "description": "A competitor met the buyer first.", "target": "signal_late" },
          { "title": "One person holds the knowledge", "description": "They cannot take two weeks off.", "target": "signal_instinct" }
        ]
      }
    ],
    "chips": [{ "target": "method" }, { "target": "proof" }]
  },
  {
    "id": "signal_blindside",
    "label": "A supplier fails without warning",
    "parent": "signals",
    "intents": ["supplier fails", "insolvency", "warning"],
    "tags": ["overview"],
    "blocks": [
      {
        "type": "callout",
        "text": "Example. A company's main supplier stopped trading. They found out from a LinkedIn post. The same day, a client asked where their delivery was."
      },
      {
        "type": "text",
        "content": "Public records often show the warning signs weeks earlier. I build systems that read them daily and email you the morning something changes."
      }
    ],
    "chips": [{ "target": "signal_monday" }, { "target": "method" }, { "target": "signals" }]
  },
  {
    "id": "signal_monday",
    "label": "Reports built by hand",
    "parent": "signals",
    "intents": ["report", "reports", "spreadsheet", "spreadsheets", "copy data"],
    "tags": ["overview"],
    "blocks": [
      {
        "type": "callout",
        "text": "Example. Every Monday, one person spends the day copying data from five places into one spreadsheet. A second person checks it. It still has mistakes."
      },
      {
        "type": "text",
        "content": "I build a system that produces the report before the working day starts. Same steps, every time. No copying errors. The person who made it does other work."
      }
    ],
    "chips": [{ "target": "estimate" }, { "target": "signal_late" }, { "target": "method" }, { "target": "signals" }]
  },
  {
    "id": "signal_late",
    "label": "Tenders found too late",
    "parent": "signals",
    "intents": ["tender", "tenders", "contracts", "too late"],
    "tags": ["overview"],
    "blocks": [
      { "type": "callout", "text": "Example. A company heard about a public tender late. The winner had already met the buyer twice." },
      {
        "type": "text",
        "content": "Whoever hears first usually has a system checking public notices daily. Mine checks five public registers every night. Yours would check the sources in your market."
      }
    ],
    "chips": [{ "target": "signal_instinct" }, { "target": "method" }, { "target": "signals" }]
  },
  {
    "id": "signal_instinct",
    "label": "One person holds the knowledge",
    "parent": "signals",
    "intents": ["only one person", "key person", "holiday", "time off"],
    "tags": ["overview"],
    "blocks": [
      {
        "type": "callout",
        "text": "Example. An owner has not taken two weeks off in six years. Not for lack of money. The knowledge to run the business is only in their head."
      },
      {
        "type": "text",
        "content": "I write down the checks and decisions that person makes. Then I automate the routine ones. The work continues while they are away."
      }
    ],
    "chips": [{ "target": "method" }, { "target": "proof" }, { "target": "signals" }]
  },
  {
    "id": "trust_ladder",
    "label": "How a new system is tested",
    "parent": "method",
    "intents": ["trust", "safe", "safety", "risk", "testing", "supervised", "control", "mistakes"],
    "tags": ["overview"],
    "blocks": [
      {
        "type": "flow",
        "layout": "horizontal",
        "title": "Four stages, in order",
        "nodes": [
          { "id": "yd", "label": "You do it" },
          { "id": "sg", "label": "System suggests" },
          { "id": "ck", "label": "System acts, you check" },
          { "id": "rn", "label": "System runs alone", "variant": "accent" }
        ],
        "edges": [{ "from": "yd", "to": "sg" }, { "from": "sg", "to": "ck" }, { "from": "ck", "to": "rn" }]
      },
      { "type": "text", "content": "One stage at a time. No skipping. If mistakes rise, the system moves back a stage automatically." },
      { "type": "callout", "text": "In one of my systems, two of three tasks now run alone. The third is still checked." }
    ],
    "chips": [{ "target": "callsheet_zero_ops" }, { "target": "proof" }, { "target": "process" }]
  },
  {
